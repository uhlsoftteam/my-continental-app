{
  "expo": {
    "name": "MyContinental",
    "slug": "MyContinental",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/continental_hospital.jpg",
    "splash": {
      "image": "./assets/continental_hospital.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/continental_hospital.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.naim5829.MyContinental"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker"
    ]
  }
}
